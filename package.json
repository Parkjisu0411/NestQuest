{
  "name": "nestquest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/serve-local.mjs",
    "local": "npm run build && npm start",
    "build": "npm run seed:prepare && tsc -b && vite build && node scripts/build-offline.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:doctor": "node scripts/android.mjs doctor",
    "android:apk": "npm run android:sync && node scripts/android.mjs debug",
    "android:release": "npm run android:sync && node scripts/android.mjs release",
    "map:prepare": "node --experimental-strip-types scripts/prepare-map.mjs",
    "keys:init": "node --experimental-strip-types scripts/local-keys.mjs init",
    "keys:check": "node --experimental-strip-types scripts/local-keys.mjs check",
    "api:verify": "node --experimental-strip-types scripts/verify-api.mjs",
    "map:convert": "node --experimental-strip-types scripts/convert-map.mjs",
    "map:rail:fetch": "node scripts/fetch-rail.mjs",
    "seed:prepare": "node --experimental-strip-types scripts/prepare-bootstrap.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fast-xml-parser": "^5.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
